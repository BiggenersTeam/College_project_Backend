# Copy this file to .env and fill in your values
MONGODB_URI=your-mongo-url
SECRET_KEY=your-super-secret-key-here
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# AI Voice Calling Assistant Configuration
VOICE_CALLS_ENABLED=true
VOICE_PROVIDER=auto  # "auto" | "twilio" | "vapi"

# Twilio Voice API
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Vapi AI Voice API (Optional / Alternative Provider)
VAPI_API_KEY=your-vapi-api-key
VAPI_ASSISTANT_ID=your-vapi-assistant-id
VAPI_PHONE_NUMBER_ID=your-vapi-phone-number-id

# Vapi AI Phone Assistant (dedicated outbound calling feature)
# VAPI_PRIVATE_API_KEY is the same key used for server-side Vapi API calls
# Get from: https://dashboard.vapi.ai → Account → API Keys
VAPI_PRIVATE_API_KEY=your-vapi-private-api-key

# Cloudinary — persistent image storage (required for images to survive Render restarts)
# Get from: https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

